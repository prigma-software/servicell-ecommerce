# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - E-COMMERCE (MARCA BLANCA)
# Copia este archivo como .env o .env.local y completa las credenciales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS Y AUTENTICACIÓN (SUPABASE)
# ------------------------------------------------------------------------------
# Obtener en: Supabase Dashboard > Project Settings > API
# NEXT_PUBLIC_SUPABASE_URL: URL base del proyecto Supabase (ej: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Llave pública / anon (segura para exponer en cliente/navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SUPABASE_SERVICE_ROLE_KEY: Llave privilegiada de servidor (NUNCA exponer en cliente)
# Se usa para operaciones administrativas seguras, webhooks y triggers.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# SUPABASE_DB_PASSWORD: Contraseña de la base de datos PostgreSQL asignada al crear el proyecto
SUPABASE_DB_PASSWORD=your-database-password

# SUPABASE_ACCESS_TOKEN: Token personal de Supabase CLI para migraciones automáticas
# Obtener en: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token

# ------------------------------------------------------------------------------
# 2. LICENCIAMIENTO DE PLATAFORMA (PRIGMA)
# ------------------------------------------------------------------------------
# PRIGMA_URL: URL base del servidor central de licencias
PRIGMA_URL=https://prigma.net

# LICENSE_KEY: Clave de licencia única asignada a la tienda/marca (ej: lk_...)
LICENSE_KEY=your-pragma-license-key

# ------------------------------------------------------------------------------
# 3. CANALES DE NOTIFICACIONES (FEATURE FLAGS)
# ------------------------------------------------------------------------------
# Por defecto se dejan en 'false'. Activa según los canales contratados por la marca.
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_WHATSAPP_NOTIFICATIONS=false

# ------------------------------------------------------------------------------
# 4. NOTIFICACIONES POR CORREO ELECTRÓNICO (RESEND)
# ------------------------------------------------------------------------------
# Obtener en: https://resend.com/api-keys y https://resend.com/domains
RESEND_API_KEY=your-resend-api-key

# Dirección remitente verificada en Resend (ej: "Mi Tienda <notificaciones@mitienda.com>")
RESEND_FROM_EMAIL="Mi Tienda <onboarding@mitienda.com>"

# Correo administrativo que recibirá alertas de nuevas órdenes y eventos de tienda
ADMIN_EMAIL=admin@mitienda.com

# URL pública de la aplicación para enlaces de seguimiento en correos y mensajes
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. WHATSAPP CLOUD API (META GRAPH API)
# ------------------------------------------------------------------------------
# Obtener en: https://developers.facebook.com > Tu App > WhatsApp > API Setup

# Modo de entorno activo: "test" (Sandbox Meta +1 555) o "production" (Línea oficial cliente)
WHATSAPP_ENV=test

# ID del número de pruebas generado por Meta en el Sandbox (+1 555...)
WHATSAPP_PHONE_NUMBER_ID_TEST=your-meta-test-phone-number-id

# ID del número de teléfono oficial registrado y verificado en Meta (+57...)
WHATSAPP_PHONE_NUMBER_ID_PROD=your-meta-prod-phone-number-id

# ID activo directo (opcional si defines los anteriores con WHATSAPP_ENV)
WHATSAPP_PHONE_NUMBER_ID=your-meta-test-phone-number-id

# Token de acceso de Meta (System User Token permanente con permisos whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=your-meta-access-token

# Versión de Meta Graph API
WHATSAPP_API_VERSION=v22.0

# Usar plantillas aprobadas por Meta. Por defecto 'false' (usa mensajes de texto libre en ventana 24h).
# Si se activa en 'true', exige que las plantillas estén aprobadas en Meta Business Manager.
WHATSAPP_USE_TEMPLATES=false

# Idioma configurado para las plantillas en Meta Business Manager (ej: es_CO o es)
WHATSAPP_TEMPLATE_LANGUAGE=es_CO

# Código de país predeterminado para normalizar teléfonos (ej: 57 para Colombia)
WHATSAPP_DEFAULT_COUNTRY_CODE=57

# Nombres de las plantillas creadas en Meta Business Manager (solo necesarias si WHATSAPP_USE_TEMPLATES=true):
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION=order_confirmation
WHATSAPP_TEMPLATE_MANUAL_ORDER=order_manual_notification
WHATSAPP_TEMPLATE_WORK_ORDER_CREATED=work_order_created
WHATSAPP_TEMPLATE_WORK_ORDER_STATUS=work_order_status_update

# ------------------------------------------------------------------------------
# 6. PASARELA DE PAGOS (WOMPI COLOMBIA)
# ------------------------------------------------------------------------------
# Obtener en: https://dashboard.wompi.co o https://sandbox.wompi.co > Desarrolladores

# Llave pública del comercio (expuesta en cliente para inicializar el widget de checkout)
# Comienza con 'pub_test_' en pruebas o 'pub_prod_' en producción
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_your-wompi-public-key

# Secreto de integridad (generación de hash SHA-256 para firmar transacciones seguras)
# Evita alteraciones de montos, moneda o referencias en el proceso de pago.
# Comienza con 'test_integrity_' o 'prod_integrity_'
WOMPI_INTEGRITY_SECRET=test_integrity_your-integrity-secret

# Secreto de eventos webhook (usado por /api/webhooks/wompi para validar firmas criptográficas)
# Comienza con 'test_events_' o 'prod_events_'
WOMPI_EVENTS_SECRET=test_events_your-events-secret

# ------------------------------------------------------------------------------
# 7. MANTENIMIENTO AUTOMÁTICO Y CRON JOBS
# ------------------------------------------------------------------------------
# Secreto Bearer para proteger el endpoint POST /api/cron/maintenance
# Generar una cadena criptográfica segura (ej: openssl rand -hex 32)
# El servicio externo (Cron-Job.org, Cloudflare Cron Trigger) debe enviar:
# Header: "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=your-secure-cron-token-here

# ------------------------------------------------------------------------------
# 8. METADATOS Y SEO DEL SITIO (OPCIONALES)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Nombre de la Tienda"
NEXT_PUBLIC_SITE_DESCRIPTION="Descripción de la tienda para motores de búsqueda y redes sociales"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
